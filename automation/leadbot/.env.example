# Токен бота от @BotFather
BOT_TOKEN=
# Кому приходят заявки: Telegram ID через запятую (свой ID можно узнать у @userinfobot)
OWNER_CHAT_IDS=
# Секрет для формы на сайте (заголовок X-Lead-Token). Любая длинная случайная строка:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
LEAD_TOKEN=
# Необязательно: другой файл настроек вместо config.yaml
CONFIG=config.yaml
