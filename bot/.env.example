# Токен бота от @BotFather
BOT_TOKEN=
# Telegram ID администраторов через запятую (для /stats)
ADMIN_IDS=
# Подписка: цена в Telegram Stars за 30 дней и лимиты
PRICE_STARS=450
MONTHLY_RUNS=30
SUB_CLIPS=8
# Бесплатно: сколько видео и клипов с каждого
FREE_RUNS=1
FREE_CLIPS=3
# Качество распознавания речи: tiny / base / small / medium / large-v3
WHISPER=small
# Параллельных рендеров (каждый занимает 1–2 ядра CPU)
WORKERS=1
# Максимальный размер видео по ссылке, МБ
MAX_URL_MB=2000
# Необязательно: выбор моментов через Claude
ANTHROPIC_API_KEY=
# Необязательно: свой Bot API сервер (снимает лимит 20 МБ на скачивание файлов из Telegram)
TELEGRAM_API_URL=
# Где хранить базу и файлы заданий
DATA_DIR=data
